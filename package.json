{
  "name": "lazycat-neko-webshell",
  "version": "0.8.8",
  "private": true,
  "type": "module",
  "scripts": {
    "check:versions": "node scripts/check-version-consistency.mjs",
    "proto:ts": "buf generate",
    "test": "npm run test:frontend && npm run test:release",
    "test:browser": "node tests-auto/run.mjs",
    "test:frontend": "find src/frontend/src -name '*.test.mjs' -exec node --test --experimental-strip-types {} +",
    "test:release": "node --test scripts/*.test.mjs",
    "typecheck": "npm run proto:ts && tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "dev": "npm run proto:ts && vite --host 127.0.0.1"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.15.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-web": "2.2.0",
    "@lobehub/icons-static-svg": "^1.95.1",
    "lucide": "^1.48.0",
    "restty": "0.3.0",
    "trzsz": "^1.1.6",
    "zmodem-ts": "^1.0.8"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.73.0",
    "@bufbuild/protoc-gen-es": "2.15.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "ws": "8.22.0"
  }
}
