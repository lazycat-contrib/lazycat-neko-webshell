{
  "name": "lazycat-neko-webshell",
  "version": "0.5.22",
  "private": true,
  "type": "module",
  "scripts": {
    "proto:ts": "buf generate",
    "test": "node --test --experimental-strip-types src/frontend/src/*.test.mjs src/frontend/src/**/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run proto:ts && npm run typecheck && vite build",
    "dev": "npm run proto:ts && vite --host 127.0.0.1"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.12.0",
    "@connectrpc/connect": "2.1.1",
    "@connectrpc/connect-web": "2.1.1",
    "lucide": "^0.475.0",
    "restty": "^0.1.35",
    "trzsz": "^1.1.6",
    "zmodem-ts": "^1.0.8"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.69.0",
    "@bufbuild/protoc-gen-es": "2.12.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  }
}
