{
  "name": "lazycat-neko-webshell",
  "version": "0.7.27",
  "private": true,
  "type": "module",
  "scripts": {
    "check:versions": "node scripts/check-version-consistency.mjs",
    "proto:ts": "buf generate",
    "test": "npm run test:frontend && npm run test:release",
    "test:frontend": "find src/frontend/src -name '*.test.mjs' -exec node --test --experimental-strip-types {} +",
    "test:release": "node --test scripts/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run proto:ts && npm run typecheck && vite build",
    "dev": "npm run proto:ts && vite --host 127.0.0.1"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.12.0",
    "@connectrpc/connect": "2.1.1",
    "@connectrpc/connect-web": "2.1.1",
    "@lobehub/icons-static-svg": "^1.94.0",
    "lucide": "^0.475.0",
    "restty": "0.2.6",
    "trzsz": "^1.1.6",
    "zmodem-ts": "^1.0.8"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.69.0",
    "@bufbuild/protoc-gen-es": "2.12.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
