  "metadata": {
    "builtin": "true",
    "runtime": "browser-audio",
    "floatingControls": "true",
    "autoPlayOnSelect": "true"
  },
  "resources": [
    "media",
    "ui"
  ],
  "frontend": {
    "entry": "white-noise/entry.ts",
    "tool": true,
    "icon": "waves",
    "nameKey": "plugin.whiteNoise.name",
    "descriptionKey": "plugin.whiteNoise.description"
  },
  "configuration": {
    "version": 1,
    "metadata": {
      "autoPlayOnSelect": {
        "type": "boolean"
      },
      "floatingControls": {
        "type": "boolean"
      }
    },
    "preferences": []
  }
}
