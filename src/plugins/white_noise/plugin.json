{
  "id": "white-noise",
  "kind": "sound",
  "display_name": "White Noise",
  "description": "Play local focus sounds from the provider sounds directory without bundling audio in the frontend.",
  "input_schema_json": "{\"operation\":\"catalog|playback\",\"metadata\":{\"soundsDir\":\"/lzcapp/var/sounds\",\"formats\":\"mp3,wav,ogg,flac,m4a,webm\"}}",
  "output_schema_json": "{\"rootPath\":\"string\",\"exists\":true,\"files\":[{\"id\":\"string\",\"category\":\"string\",\"url\":\"/sounds/...\"}]}",
  "scopes": [
    "productivity",
    "sound"
  ],
  "accepted_content_types": [],
  "produced_content_types": [],
