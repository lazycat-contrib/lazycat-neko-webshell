{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neko-remoted-relay",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-01",
  "durable_objects": {
    "bindings": [
      { "name": "TUNNELS", "class_name": "Tunnel" },
      { "name": "ADMISSION", "class_name": "Admission" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Tunnel", "Admission"] }],
  "observability": { "enabled": false }
}
